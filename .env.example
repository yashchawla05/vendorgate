# Copy to .env for local runs. On Streamlit Community Cloud put these in
# App settings -> Secrets as ROOT-level TOML keys (KEY = "value"), which
# Streamlit also exposes as environment variables.

# LLM: auto = Claude if ANTHROPIC_API_KEY is set, else Gemini if GEMINI_API_KEY is set,
# else offline rule-based mode. Or force one: anthropic | gemini | offline
LLM_PROVIDER=auto
# Claude (Anthropic API, paid)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Gemini (Google AI Studio key; the free tier works but is rate limited)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Backup models, tried in order when the main one is busy (503 "high demand"), rate limited or retired.
# none = no backups
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
# Requests per minute this app sends to Gemini (free tier Flash-Lite allows 10). 0 = no pacing
GEMINI_RPM=10
# minimal | low | medium | high
GEMINI_THINKING_LEVEL=low
# Cost guard
LLM_MAX_PAGES_PER_DOC=4
LLM_MAX_DOCS_PER_SUBMISSION=8

# Public URL of the app, used to build resubmission links in emails
APP_BASE_URL=http://localhost:8501

# Email: simulated (default, writes to outbox only) | resend | smtp
EMAIL_MODE=simulated
RESEND_API_KEY=
EMAIL_FROM=onboarding@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional override of the SQLite path (default data/runtime/vendorgate.db)
VG_DB_PATH=
